# ─── Base de donnees ────────────────────────────────────────────────────────
# PostgreSQL (Neon, Supabase, Railway ou instance locale)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Authentification (NextAuth v5) ─────────────────────────────────────────
# Generer un secret : npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET="remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3010"

# ─── Assistant IA ───────────────────────────────────────────────────────────
# Fournisseur : "anthropic" | "openai" | "local"
# "local" = moteur deterministe interne, aucune cle requise (mode par defaut)
AI_PROVIDER="local"
AI_MODEL="claude-sonnet-5"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ─── Stockage des fichiers ──────────────────────────────────────────────────
# "local" = dossier storage/uploads ; "s3" = compatible S3 (a brancher)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="storage/uploads"
